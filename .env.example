# Example environment variables for running the agent
# Copy to .env and fill values before running

# Generic LLM provider config — works with any OpenAI-compatible chat completions API
# (OpenAI, xAI/Grok, Groq, Together, etc.)
LLM_API_KEY=
LLM_API_BASE=https://api.x.ai/v1
LLM_MODEL=grok-4

# --- Examples for other providers (uncomment and adjust one) ---
# OpenAI:
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Groq:
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-70b-versatile

# Legacy variable names (still supported as fallbacks for backward compatibility)
# OPENAI_API_KEY=
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_API_BASE=
# XAI_MODEL=
# GROK_MODEL=

# LangSmith (optional tracing/observability dashboard: https://smith.langchain.com)
# Get a key from https://smith.langchain.com/settings, then set LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-docusearch

# App/runtime config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
DOCUSEARCH_LITE_MODE=true